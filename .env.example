# Copy to .env and change the passwords: cp .env.example .env

# --- Database ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-db-password

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=production
# Image used by `app`. Locally it is built from the Dockerfile; on a server point it to the registry:
# APP_IMAGE=ghcr.io/<owner>/<repo>
APP_IMAGE=devops-template-app
APP_TAG=latest

# --- Published ports ---
HTTP_PORT=80
GRAFANA_PORT=3000

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
PROMETHEUS_RETENTION=15d

# --- Backups ---
# Every 6 hours, keep the last 7 dumps
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=7
